# OpsVista — environment configuration
# Copy this file to `.env` at the repo root and fill in real values.
# Nothing here is a secret; it's just a template.

# ---------------------------------------------------------------------------
# Supabase (auth + Postgres) — required to boot without warnings, but the app
# will still start with placeholder values below for local RAG-only testing.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# LLM / Embedding provider — pick ONE real provider, or leave both blank and
# set USE_MOCK_EMBEDDINGS=true to run the whole pipeline with deterministic
# mock embeddings (no billing, no key, but poor semantic relevance).
#
# Provider priority at runtime: OpenAI > Gemini > mock.
# ---------------------------------------------------------------------------

# Option A: Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 defaults to 3072 dims, which exceeds pgvector's
# 2000-dim index cap — 1536 keeps both the JSON index and pgvector usable.
GEMINI_EMBEDDING_DIM=1536

# Option B: OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000

USE_MOCK_EMBEDDINGS=true

# ---------------------------------------------------------------------------
# Google Drive (document source) — only needed once you wire up real Drive
# ingestion; safe to leave blank while developing against local documents.
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_CREDENTIALS_PATH=backend/credentials/google_credentials.json

# ---------------------------------------------------------------------------
# RAG / index settings
# ---------------------------------------------------------------------------
RAG_INDEX_PATH=backend/app/features/rag_chatbot/vector/enhanced_index.json
TOP_K=4

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
DATABASE_URL=
ENVIRONMENT=development
